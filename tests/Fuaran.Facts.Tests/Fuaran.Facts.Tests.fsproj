<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The Fable leg lives beside this project and is built by `dotnet fable`, not by MSBuild. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Fable/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared with the Fable leg: pure F#, no test framework. -->
    <Compile Include="Certify.fs" />
    <Compile Include="SameInputs.fs" />
    <Compile Include="RenderingVectors.fs" />
    <!-- .NET only. -->
    <Compile Include="Corpus.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Facts\Fuaran.Facts.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
  </ItemGroup>
</Project>

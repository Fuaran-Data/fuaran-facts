<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- The consumer-shaped JavaScript leg: this package's Fable source compiled in ONE project beside the
       published Fuaran.Core.Column source, as a consumer that takes both compiles them. Names in one
       package's source can resolve to the other's there and nowhere else, so the package's own leg cannot
       see the fault this one is for. Built by `dotnet fable`, never by MSBuild, and in no solution. The
       gate runs it twice: at the Fuaran.Core.Column version a current consumer takes, and at the
       version this repository pins its Fuaran.Core packages to. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <FuaranCoreColumnConsumerVersion Condition="'$(FuaranCoreColumnConsumerVersion)' == ''">0.42.0</FuaranCoreColumnConsumerVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Fuaran.Facts\Fuaran.Facts.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fuaran.Core.Column" VersionOverride="$(FuaranCoreColumnConsumerVersion)" />
  </ItemGroup>
</Project>
<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources: nuget.org, and nothing else. Every package this repository depends on is
  published there, so an outside clone restores exactly what the gate restores (DECISIONS.md D3).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
